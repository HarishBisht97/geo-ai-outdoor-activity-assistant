# ---------------------------------------------------------------------------
# GeoAI Outdoor Assistant - backend configuration (copy to backend/.env)
# No real credentials belong in this file.
# ---------------------------------------------------------------------------

APP_ENV=production            # production | development | test
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:5173   # comma-separated frontend origins for CORS

# Identifies the app to Nominatim / Overpass per their usage policies.
CONTACT_EMAIL=
GEOCODER_COUNTRY_BIAS=in      # ISO country code(s) or empty for worldwide

# External services (all free, no keys required)
NOMINATIM_URL=https://nominatim.openstreetmap.org
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_AQ_URL=https://air-quality-api.open-meteo.com/v1/air-quality
OPEN_METEO_ELEVATION_URL=https://api.open-meteo.com/v1/elevation
OSRM_DRIVING_URL=https://router.project-osrm.org
OSRM_FOOT_URL=https://routing.openstreetmap.de/routed-foot
OSRM_BIKE_URL=https://routing.openstreetmap.de/routed-bike

# Self-hosted SLM (llama.cpp GGUF)
SLM_ENABLED=true
MODEL_REPO=
MODEL_REVISION=main
MODEL_FILE=Qwen3-1.7B-Q4_K_M.gguf
MODEL_PATH=models/Qwen3-1.7B-Q4_K_M.gguf   # Space image: /models/Qwen3-1.7B-Q4_K_M.gguf
N_CTX=4096
N_THREADS=2
SLM_INTENT_TIMEOUT_S=25
SLM_EXPLAIN_TIMEOUT_S=50
SLM_MAX_REGENERATIONS=0
SLM_QUEUE_MAX=4

# Request limits
REQUEST_TIMEOUT_S=90
MAX_CONCURRENT_REQUESTS=3
MAX_RADIUS_KM=50
MAX_WINDOW_DAYS=7
MAX_CANDIDATES=12
RATE_LIMIT_PER_MIN=10

# Cache TTLs (seconds)
CACHE_TTL_GEOCODE=604800
CACHE_TTL_PLACES=86400
CACHE_TTL_CONTEXT=86400
CACHE_TTL_WEATHER=1800
CACHE_TTL_AIR=3600
CACHE_TTL_ROUTING=21600
CACHE_TTL_ELEVATION=2592000

# Optional
OPENAQ_API_KEY=
